<h3>予定情報一覧</h3>

<table>
  <thead>
    <tr>
      <th>id</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>詳細</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.to_fs(:date_jp) %></td>
        <td><%= schedule.end_date.to_fs(:date_jp) %></td>
        <td><%= schedule.done ? "○" : "" %></td>
        <td><%= schedule.updated_at.to_fs(:datetime_jp) %></td>
        <td>
          <%= link_to "詳細", schedule %>
        </td>
        <td>
          <%= link_to "編集", [:edit, schedule] %>
        </td>
        <td>
          <%= link_to "削除", schedule, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>スケジュールの数: <%= @schedules.size %></p>
<p>本日の日付: <%= Date.today.strftime("%Y年%m月%d日") %></p>
<p><%= link_to "予定新規登録", new_schedule_path %></p>
