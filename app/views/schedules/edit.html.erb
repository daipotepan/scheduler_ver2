<h3>予定新規登録<h3>

<%= form_with model: @schedule do |f| %>
  <table>
    <tr>
      <th><%= f.label :title ,"タイトル" %></th>
      <th><%= f.text_field :title %></th>
    </tr>

    <tr>
      <th><%= f.label :start_date ,"開始日" %></th>
      <th><%= f.text_field :start_date %></th>
    </tr>

    
    <tr>
      <th><%= f.label :end_date ,"終了日" %></th>
      <th><%= f.text_field :end_date %></th>
    </tr>

    <tr>
      <th><%= f.label :memo, "メモ" %></th>
      <th><%= f.text_area :memo %></th>
    </tr>

    <tr>
      <th><%= f.label :done, "終日" %></th>
      <th><%= f.check_box :done %></th>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "編集完了する" %></li>
      <li><%= link_to "一覧に戻る", schedules_path %></li>
    </ul>
  </div>

<% end %>